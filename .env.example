# silver-spoon2 — environment configuration template.
#
# Copy to `.env` (gitignored) and edit as needed. Defaults shown match
# DESIGN.md §6.4. Variables are added incrementally as each task introduces
# the module that consumes them.

# --- Wikipedia REST API (T02) ---
WIKIPEDIA_API_BASE=https://en.wikipedia.org/api/rest_v1
# Replace <user>/<email> with real values before deploying.
WIKIPEDIA_USER_AGENT=silver-spoon/0.1 (https://github.com/<user>/silver-spoon2; contact: <email>)
WIKIPEDIA_FETCH_TIMEOUT_S=15

# --- Article cleaning (T03) ---
# Refuse to ingest cleaned bodies below this length (F9/OQ-9).
ARTICLE_MIN_CHARS=500
# Truncate cleaned bodies longer than this at the nearest section boundary (A9/U13).
ARTICLE_CHAR_CAP=200000

# --- Chunking (T04) — all three A10 tunables, configurable per U11. ---
# Sections at or below this token count are emitted as a single chunk.
CHUNK_SECTION_CEILING_TOKENS=1000
# Sections above the ceiling are sub-chunked at approximately this token size.
CHUNK_SUB_SIZE_TOKENS=512
# Consecutive sub-chunks overlap by approximately this many tokens (snapped to paragraph boundaries).
CHUNK_SUB_OVERLAP_TOKENS=64

# --- Embedding (T05) — one-env-var swap per §12 Challenge 1. ---
# sentence-transformers model id. 384-dim for the bge-small default.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Batch size for in-process embedding (Embedder.embed_texts).
EMBEDDING_BATCH_SIZE=64
